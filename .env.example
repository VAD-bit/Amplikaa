# ============================================================
# AMPLIKAA — Plantilla de variables de entorno
# Copia este archivo a .env.local y completa tus valores.
# Panel de Supabase → Project Settings → API
# ============================================================

# REQUERIDO: URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# REQUERIDO: clave ANON (pública, segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=PEGA-AQUI-TU-ANON-KEY

# OPCIONAL: site URL para links absolutos en producción
NEXT_PUBLIC_SITE_URL=https://amplikaa.com

# OPCIONAL: clave de backend para el dashboard (NUNCA con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=PEGA-AQUI-TU-SERVICE-ROLE-KEY
